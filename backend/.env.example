# Sarthi Pay Environment Configuration

# Application
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./sarthi_pay.db

# Speech Services (Gnani.ai)
# Get keys from Gnani.ai developer console: https://console.gnani.ai/
GNANI_STT_API_KEY=
GNANI_STT_ENDPOINT=https://api.gnani.ai/asr/v1/stream
GNANI_TTS_API_KEY=
GNANI_TTS_ENDPOINT=https://api.gnani.ai/tts/v3/synthesize
GNANI_DEFAULT_LANG=hi-IN
GNANI_TIMBRE_VOICE=expressive_hindi_female_1

# LLM Reasoning Engine (Evon v3.3)
# HF endpoint or local vLLM endpoint
HUGGINGFACE_API_KEY=
EVON_API_URL=https://api-inference.huggingface.co/models/gnani-ai/evon-v3.3
EVON_MODEL_NAME=gnani-ai/evon-v3.3

# Demo Mode
# If True, enables realistic fallback simulations when API keys are not provided
ENABLE_FALLBACK_SIMULATION=True

